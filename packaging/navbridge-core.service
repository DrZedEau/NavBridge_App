[Unit]
Description=NavBridge Android Auto, audio, GNSS and I-Bus backend
Wants=gpsd.socket
After=local-fs.target sound.target gpsd.socket
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
Group=@GROUP@
SupplementaryGroups=plugdev audio dialout
WorkingDirectory=/opt/navbridge
# The IPC socket and the projection frames, for the service's group only.
# Kept while the core stops or restarts, so the UI's watch on it holds.
RuntimeDirectory=navbridge
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
# Keeps settings that survive a restart, such as wireless mode.
StateDirectory=navbridge
ExecStart=/opt/navbridge/bin/navbridge-core --config /opt/navbridge/config/core.toml
Restart=on-failure
# The core exits when a part of it fails for good. Restarts come after 2 s,
# then wait longer each time, up to 30 s: 2, 4, 8, 15, 30 s. The count starts
# again at each boot (systemd 254 or later; older ones ignore the steps).
RestartSec=2
RestartSteps=4
RestartMaxDelaySec=30
Environment=RUST_LOG=info
UMask=0007

[Install]
WantedBy=multi-user.target
