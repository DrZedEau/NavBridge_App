# Android phone and AOA USB permissions.
# Whoever made it, a device showing what NavBridge looks for in a phone: a
# file-transfer (MTP or PTP, 06/01) or ADB (ff/42/01) interface.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{ID_USB_INTERFACES}=="*:0601??:*|*:ff4201:*", MODE="0660", GROUP="plugdev", TAG+="uaccess"
# By maker, for a udev that does not list interfaces, and for 18d1's accessory
# mode: Google, Samsung, Motorola, Xiaomi, OnePlus, Sony, Huawei, LG, HTC, Asus,
# vivo, then Oppo and Realme, ZTE, Lenovo, TCL and Alcatel, Fairphone, HMD
# (Nokia), Honor, Meizu and Sharp.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="18d1", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="04e8", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="22b8", MODE="0660", GROUP="plugdev", TAG+="uaccess"
