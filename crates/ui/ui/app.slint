// Warm amber on black, matching the NavBridge splash artwork.
export global AmberPalette {
    out property <color> background: #000000;
    out property <color> surface: #100a03;
    out property <color> selected-surface: #2a1804;
    out property <color> amber: #ff6600;
    out property <color> text: #ffc65c;
    out property <color> muted: #c48a40;
    out property <color> border: #704000;
    out property <color> selected-text: #080400;
    // Status lights.
    out property <color> led-on: #3ddc4a;
    out property <color> led-waiting: #ff9f0a;
    out property <color> led-off: #ff3b30;
}

// Green: active; orange: present but not ready (a GNSS receiver without a fix);
// red: not active.
export enum LedState { off, waiting, on }

// One row in Settings: what it sets, and its current value.
export struct SettingsRow {
    // The section this row starts, shown above it; empty within a section.
    section: string,
    label: string,
    value: string,
    // A switch in place of the value, on or off.
    toggle: bool,
    on: bool,
}

// An on/off switch without text: on, its track is filled and its knob is
// right. `inverse` draws it on the chosen row's amber fill.
component Switch inherits Rectangle {
    in property <bool> on;
    in property <bool> inverse;
    width: 34px;
    height: 18px;
    border-radius: 9px;
    border-width: 1px;
    border-color: root.inverse ? AmberPalette.selected-text
        : root.on ? AmberPalette.amber : AmberPalette.muted;
    background: !root.on ? transparent
        : root.inverse ? AmberPalette.selected-text : AmberPalette.amber;
    Rectangle {
        x: root.on ? root.width - self.width - 3px : 3px;
        y: 3px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: root.inverse ? (root.on ? AmberPalette.amber : AmberPalette.selected-text)
            : root.on ? AmberPalette.selected-text : AmberPalette.muted;
        animate x { duration: 120ms; }
    }
}

// The one choice on the Phone page, in wireless mode: its switch is on while
// phones can find NavBridge and pair.
component PairSwitch inherits Rectangle {
    in property <bool> on;
    height: 34px;
    border-radius: 7px;
    background: AmberPalette.amber;
    Text {
        x: 14px; width: parent.width - 28px; height: parent.height;
        text: "PAIR A PHONE";
        color: AmberPalette.selected-text;
        font-size: 15px;
        vertical-alignment: center;
    }
    Switch {
        x: parent.width - self.width - 14px;
        y: (parent.height - self.height) / 2;
        on: root.on;
        inverse: true;
    }
}

component Led inherits Rectangle {
    in property <LedState> level;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background: root.level == LedState.on ? AmberPalette.led-on
        : root.level == LedState.waiting ? AmberPalette.led-waiting : AmberPalette.led-off;
}

// A label and its status light.
component Indicator inherits HorizontalLayout {
    in property <string> label;
    in property <LedState> level;
    spacing: 5px;
    Text {
        text: root.label;
        color: AmberPalette.muted;
        font-size: 11px;
        font-weight: 700;
        vertical-alignment: center;
    }
    VerticalLayout {
        alignment: center;
        Led { level: root.level; }
    }
}

component MenuTile inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected;
    width: 112px;
    height: 124px;
    border-radius: 8px;
    background: root.selected ? AmberPalette.selected-surface : AmberPalette.surface;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? AmberPalette.amber : AmberPalette.border;
    Image {
        x: (root.width - 64px) / 2;
        y: 16px;
        width: 64px;
        height: 64px;
        source: root.icon;
    }
    Text {
        x: 0px; y: 88px; width: root.width; height: 26px;
        text: root.label;
        color: root.selected ? AmberPalette.amber : AmberPalette.text;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component AppWindow inherits Window {
    width: 400px;
    height: 240px;
    title: "NavBridge";
    background: AmberPalette.background;

    // 0 menu, 1 Phone, 2 System, 3 Settings
    in property <int> screen: 0;
    // Menu tiles: 0 Phone, 1 Settings, 2 System.
    in property <int> menu-index: 0;
    in property <bool> core-connected: false;
    in property <LedState> bt-led: LedState.off;
    in property <LedState> wifi-led: LedState.off;
    in property <LedState> gnss-led: LedState.off;
    // Local time, "14:05".
    in property <string> clock: "";
    in property <string> projection-status: "Waiting";
    in property <image> projection-frame;
    in property <bool> video-active: false;
    in property <bool> wireless-enabled: false;
    in property <string> wireless-status: "";
    in property <string> bluetooth-status: "";
    // Settings: its rows, and the chosen one and whether Enter opened it.
    in property <[SettingsRow]> settings-rows;
    in property <int> settings-index: 0;
    in property <bool> settings-editing: false;
    // Wireless mode is on: the Phone page offers pairing, and whether phones
    // can pair now.
    in property <bool> pair-option: false;
    in property <bool> pairing: false;
    // A phone asks to pair: its name and the code to compare.
    in property <bool> pairing-request: false;
    in property <string> pairing-device: "";
    in property <string> pairing-code: "";
    in property <string> cpu-usage: "n/a";
    in property <string> ram-usage: "n/a";
    in property <string> cpu-temperature: "n/a";
    in property <string> usb-device-status: "n/a";
    in property <string> usb-device-name: "n/a";
    in property <int> system-page: 0;
    in property <string> gnss-receiver: "n/a";
    in property <string> gnss-status: "n/a";
    in property <string> gnss-satellites: "n/a";
    in property <string> gnss-position: "n/a";
    in property <string> gnss-altitude: "n/a";
    in property <string> gnss-speed: "n/a";
    in property <string> gnss-hdop: "n/a";
    in property <string> gnss-utc: "n/a";

    in property <string> connected-phone: "n/a";
    in property <string> ui-resolution: "n/a";
    in property <string> projection-resolution: "n/a";
    in property <string> projection-dpi-fps: "n/a";
    in property <string> audio-codec: "n/a";
    in property <string> audio-sample-rate: "n/a";
    in property <string> audio-volume: "n/a";
    // The car, from its I-Bus.
    in property <string> vehicle-status: "n/a";
    in property <string> vehicle-speed: "n/a";
    in property <string> vehicle-gnss-speed: "";
    in property <string> vehicle-rpm: "n/a";
    in property <string> vehicle-coolant: "n/a";
    in property <string> vehicle-outside: "n/a";
    in property <string> vehicle-ignition: "n/a";
    in property <string> vehicle-odometer: "n/a";

    callback key-event(string, bool, bool);
    // Invoked from Rust when the core has published a new projection frame.
    callback frame-ready();
    // Invoked from Rust when messages from the core are waiting.
    callback core-message();

    // Keyboard is the only UI interaction path.
    forward-focus: keyboard;
    keyboard := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            root.key-event(event.text, true, event.repeat);
            accept
        }
        key-released(event) => {
            root.key-event(event.text, false, false);
            accept
        }
    }

    if root.screen == 0: Rectangle {
        x: 0px; y: 0px; width: 400px; height: 240px;
        background: AmberPalette.background;

        Text {
            x: 12px; y: 6px; width: 200px; height: 26px;
            text: "NavBridge";
            color: AmberPalette.amber;
            font-size: 20px;
            font-weight: 700;
            vertical-alignment: center;
        }
        HorizontalLayout {
            x: 200px; y: 6px; width: 188px; height: 26px;
            alignment: end;
            Indicator {
                label: "CORE";
                level: root.core-connected ? LedState.on : LedState.off;
            }
        }
        Rectangle {
            x: 12px; y: 38px; width: 376px; height: 1px;
            background: AmberPalette.border;
        }

        for tile[index] in [
            { label: "Phone", icon: @image-url("icons/phone.png") },
            { label: "Settings", icon: @image-url("icons/settings.png") },
            { label: "System", icon: @image-url("icons/system.png") },
        ]: MenuTile {
            x: 12px + index * 132px;
            y: 58px;
            icon: tile.icon;
            label: tile.label;
            selected: index == root.menu-index;
        }

        Rectangle {
            x: 12px; y: 202px; width: 376px; height: 1px;
            background: AmberPalette.border;
        }
        HorizontalLayout {
            x: 12px; y: 208px; width: 260px; height: 26px;
            alignment: start;
            spacing: 14px;
            Indicator { label: "BT"; level: root.bt-led; }
            Indicator { label: "WIFI"; level: root.wifi-led; }
            Indicator { label: "GNSS"; level: root.gnss-led; }
        }
        Text {
            x: 288px; y: 208px; width: 100px; height: 26px;
            text: root.clock;
            color: AmberPalette.text;
            font-size: 15px;
            font-weight: 700;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    // The connected phone's screen: Android Auto, the only projection in this
    // build; CarPlay will show here too.
    if root.screen == 1: Rectangle {
        // Wired Android Auto is negotiated at 800x480 with configurable DPI. The backend performs
        // software H.264 decode and publishes this exact 400x240 presentation.
        x: 0px; y: 0px; width: 400px; height: 240px;
        background: AmberPalette.background;

        if root.video-active: Image {
            x: 0px; y: 0px; width: 400px; height: 240px;
            source: root.projection-frame;
        }

        if !root.video-active: Rectangle {
            x: 0px; y: 0px; width: 400px; height: 240px;
            background: AmberPalette.background;
            Text {
                x: 12px; y: 5px; width: 376px; height: 23px;
                text: "Phone";
                color: AmberPalette.text; font-size: 17px; font-weight: 700;
            }
            Text {
                x: 100px; y: 5px; width: 288px; height: 23px;
                text: "Android Auto · CarPlay is not in this build yet";
                color: AmberPalette.muted; font-size: 11px;
                horizontal-alignment: right; vertical-alignment: center;
                wrap: no-wrap; overflow: elide;
            }
            Text {
                x: 12px; y: 40px; width: 376px; height: 54px;
                text: root.projection-status;
                color: AmberPalette.muted;
                font-size: 12px;
                wrap: word-wrap;
                overflow: elide;
            }
            // While wireless mode is on, how far a phone has got.
            if root.wireless-enabled: Text {
                x: 12px; y: 96px; width: 376px; height: 28px;
                text: root.wireless-status;
                color: AmberPalette.text;
                font-size: 11px;
                wrap: word-wrap;
            }
            if root.wireless-enabled: Text {
                x: 12px; y: 124px; width: 376px; height: 28px;
                text: root.bluetooth-status;
                color: AmberPalette.text;
                font-size: 11px;
                wrap: word-wrap;
            }
            if root.pair-option: PairSwitch {
                x: 12px; y: 164px; width: 376px;
                on: root.pairing;
            }
            if !root.pair-option: Text {
                x: 12px; y: 172px; width: 376px; height: 18px;
                text: "To pair a phone, turn the Hotspot on in Settings.";
                color: AmberPalette.muted;
                font-size: 11px;
            }
        }
    }

    if root.screen == 2: Rectangle {
        x: 0px; y: 0px; width: 400px; height: 240px;
        background: AmberPalette.background;
        Text {
            x: 12px; y: 5px; width: 120px; height: 23px;
            text: "System  " + (root.system-page + 1) + "/4";
            color: AmberPalette.text; font-size: 17px; font-weight: 700;
        }
        for group[index] in [
            { title: "Compute Module 5", rows: [
                { label: "CPU Usage", value: root.cpu-usage },
                { label: "RAM Usage", value: root.ram-usage },
                { label: "CPU temperature", value: root.cpu-temperature },
            ] },
            { title: "USB connection", rows: [
                { label: "USB Status", value: root.usb-device-status },
                { label: "USB device", value: root.usb-device-name },
                { label: "Connected phone", value: root.connected-phone },
            ] },
            { title: "Video", rows: [
                { label: "UI resolution", value: root.ui-resolution },
                { label: "Projection resolution", value: root.projection-resolution },
                { label: "DPI / FPS", value: root.projection-dpi-fps },
            ] },
            { title: "Audio", rows: [
                { label: "USB codec", value: root.audio-codec },
                { label: "Sampling rate", value: root.audio-sample-rate },
                { label: "Volume (ALSA mixer)", value: root.audio-volume },
            ] },
        ]: Rectangle {
            // Two sections per page: page 1 has the first two, page 2 the others.
            visible: (index < 2 ? 0 : 1) == root.system-page;
            x: 8px;
            y: 32px + (index == 0 || index == 2 ? 0px : 92px);
            width: 384px; height: 86px;
            border-radius: 4px;
            background: AmberPalette.surface;
            border-width: 1px; border-color: AmberPalette.border;
            Text {
                x: 8px; y: 4px; width: 368px; height: 18px;
                text: group.title; color: AmberPalette.amber; font-size: 14px; font-weight: 700;
            }
            for row[row-index] in group.rows: Rectangle {
                x: 8px; y: 25px + row-index * 19px; width: 368px; height: 19px;
                background: transparent;
                Text {
                    x: 0px; y: 0px; width: 130px; height: 19px;
                    text: row.label; color: AmberPalette.muted; font-size: 11px;
                    horizontal-alignment: left; vertical-alignment: center;
                    wrap: no-wrap; overflow: elide;
                }
                Text {
                    x: 136px; y: 0px; width: 232px; height: 19px;
                    text: row.value; color: AmberPalette.text; font-size: 12px;
                    horizontal-alignment: right; vertical-alignment: center;
                    wrap: no-wrap; overflow: elide;
                }
            }
        }
        if root.system-page == 2: Rectangle {
            x: 8px; y: 32px; width: 384px; height: 178px;
            border-radius: 4px; background: AmberPalette.surface;
            border-width: 1px; border-color: AmberPalette.border;
            Text {
                x: 8px; y: 3px; width: 368px; height: 20px;
                text: "GNSS Signal"; color: AmberPalette.amber; font-size: 14px; font-weight: 700;
            }
            for row[index] in [
                { label: "Receiver", value: root.gnss-receiver },
                { label: "Status / Fix", value: root.gnss-status },
                { label: "Satellites (used / view)", value: root.gnss-satellites },
                { label: "Latitude / Longitude", value: root.gnss-position },
                { label: "Altitude (MSL)", value: root.gnss-altitude },
                { label: "Speed", value: root.gnss-speed },
                { label: "HDOP", value: root.gnss-hdop },
                { label: "UTC (fix time)", value: root.gnss-utc }
            ]: Rectangle {
                x: 8px; y: 25px + index * 18px; width: 368px; height: 18px;
                Text {
                    x: 0px; y: 0px; width: 140px; height: 18px;
                    text: row.label; color: AmberPalette.muted; font-size: 11px;
                    horizontal-alignment: left; vertical-alignment: center;
                    wrap: no-wrap; overflow: elide;
                }
                Text {
                    x: 152px; y: 0px; width: 216px; height: 18px;
                    text: row.value; color: AmberPalette.text; font-size: 11px;
                    horizontal-alignment: right; vertical-alignment: center;
                    wrap: no-wrap; overflow: elide;
                }
            }
        }
        // Page 4: the car, from its I-Bus.
        if root.system-page == 3: Rectangle {
            x: 0px; y: 0px; width: 400px; height: 240px;
            Text {
                x: 132px; y: 5px; width: 256px; height: 23px;
                text: "IBUS · " + root.vehicle-status;
                color: AmberPalette.muted; font-size: 11px;
                horizontal-alignment: right; vertical-alignment: center;
                wrap: no-wrap; overflow: elide;
            }
            // Two columns of three readings.
            for tile[index] in [
                { label: "SPEED", value: root.vehicle-speed, note: root.vehicle-gnss-speed },
                { label: "ENGINE", value: root.vehicle-rpm, note: "" },
                { label: "COOLANT", value: root.vehicle-coolant, note: "" },
                { label: "OUTSIDE", value: root.vehicle-outside, note: "" },
                { label: "IGNITION", value: root.vehicle-ignition, note: "" },
                { label: "ODOMETER", value: root.vehicle-odometer, note: "" },
            ]: Rectangle {
                x: index == 0 || index == 2 || index == 4 ? 8px : 204px;
                y: 32px + (index < 2 ? 0px : index < 4 ? 60px : 120px);
                width: 188px; height: 56px;
                border-radius: 4px;
                background: AmberPalette.surface;
                border-width: 1px; border-color: AmberPalette.border;
                Text {
                    x: 8px; y: 4px; width: 172px; height: 16px;
                    text: tile.label; color: AmberPalette.amber; font-size: 11px; font-weight: 700;
                }
                Text {
                    x: 8px; y: 20px; width: 172px; height: 32px;
                    text: tile.value; color: AmberPalette.text; font-size: 22px; font-weight: 700;
                    vertical-alignment: center;
                    wrap: no-wrap; overflow: elide;
                }
                Text {
                    x: 96px; y: 4px; width: 84px; height: 16px;
                    text: tile.note; color: AmberPalette.muted; font-size: 10px;
                    horizontal-alignment: right;
                    wrap: no-wrap; overflow: elide;
                }
            }
        }
    }

    if root.screen == 3: Rectangle {
        x: 0px; y: 0px; width: 400px; height: 240px;
        background: AmberPalette.background;
        Text {
            x: 12px; y: 5px; width: 376px; height: 23px;
            text: "Settings";
            color: AmberPalette.text; font-size: 17px; font-weight: 700;
        }
        // Sections, each heading its rows. The chosen row is filled; once Enter
        // opens it, it is outlined and its value takes arrows, as Left/Right
        // then change it.
        VerticalLayout {
            x: 12px; y: 32px; width: 376px; height: 200px;
            alignment: start;
            spacing: 3px;
            for row[index] in root.settings-rows: VerticalLayout {
                // Space between sections.
                padding-top: row.section != "" && index > 0 ? 6px : 0px;
                spacing: 1px;
                if row.section != "": Text {
                    height: 15px;
                    text: row.section;
                    color: AmberPalette.amber;
                    font-size: 10px;
                    font-weight: 700;
                    vertical-alignment: bottom;
                }
                line := Rectangle {
                    property <bool> chosen: index == root.settings-index;
                    property <bool> open: self.chosen && root.settings-editing;
                    property <color> ink: self.open ? AmberPalette.amber
                        : self.chosen ? AmberPalette.selected-text : AmberPalette.text;
                    height: 24px;
                    border-radius: 5px;
                    background: self.open ? AmberPalette.selected-surface
                        : self.chosen ? AmberPalette.amber : AmberPalette.surface;
                    border-width: self.open ? 2px : 1px;
                    border-color: self.chosen ? AmberPalette.amber : AmberPalette.border;
                    Text {
                        x: 10px; width: 200px; height: parent.height;
                        text: row.label;
                        color: line.ink;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        x: 210px; width: parent.width - 220px; height: parent.height;
                        alignment: end;
                        spacing: 6px;
                        if line.open: Text {
                            text: "‹";
                            color: line.ink; font-size: 14px; font-weight: 700;
                            vertical-alignment: center;
                        }
                        if row.toggle: VerticalLayout {
                            alignment: center;
                            Switch {
                                on: row.on;
                                inverse: line.chosen && !line.open;
                            }
                        }
                        if !row.toggle: Text {
                            text: row.value;
                            color: line.ink; font-size: 14px; font-weight: 700;
                            vertical-alignment: center;
                        }
                        if line.open: Text {
                            text: "›";
                            color: line.ink; font-size: 14px; font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    if root.pairing-request: Rectangle {
        x: 0px; y: 0px; width: 400px; height: 240px;
        background: AmberPalette.background;
        Rectangle {
            x: 12px; y: 12px; width: 376px; height: 216px;
            border-radius: 8px;
            background: AmberPalette.surface;
            border-width: 2px; border-color: AmberPalette.amber;
            Text {
                x: 16px; y: 12px; width: 344px; height: 24px;
                text: "BLUETOOTH PAIRING";
                color: AmberPalette.amber; font-size: 18px; font-weight: 700;
            }
            Text {
                x: 16px; y: 42px; width: 344px; height: 36px;
                text: root.pairing-device + " asks to pair. Pair only if the phone shows this code:";
                color: AmberPalette.text; font-size: 12px;
                wrap: word-wrap;
            }
            Text {
                x: 16px; y: 82px; width: 344px; height: 76px;
                text: root.pairing-code;
                color: AmberPalette.amber; font-size: 48px; font-weight: 700;
                horizontal-alignment: center; vertical-alignment: center;
            }
            Text {
                x: 16px; y: 182px; width: 172px; height: 18px;
                text: "ENTER pair";
                color: AmberPalette.muted; font-size: 11px;
            }
            Text {
                x: 188px; y: 182px; width: 172px; height: 18px;
                text: "BACK refuse";
                color: AmberPalette.muted; font-size: 11px;
                horizontal-alignment: right;
            }
        }
    }
}
